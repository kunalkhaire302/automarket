ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5100
ConnectionStrings__SupabasePostgres=Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=VerifyFull;Timeout=10;Maximum Pool Size=20
Jwt__Key=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
Jwt__Issuer=AutoMarket
Jwt__Audience=AutoMarket.Web
AiService__BaseUrl=http://localhost:8000/
AiService__ApiKey=USE_THE_SAME_INTERNAL_SECRET_AS_AI_API_KEY
SupabaseStorage__Url=https://YOUR_PROJECT_REF.supabase.co
SupabaseStorage__Bucket=Images
SupabaseStorage__ServiceRoleKey=KEEP_THIS_SERVER_SIDE_ONLY
Resend__ApiKey=CREATE_A_NEW_KEY_AFTER_REVOKING_ANY_EXPOSED_KEY
Resend__From=AutoMarket <notifications@YOUR_VERIFIED_DOMAIN>
